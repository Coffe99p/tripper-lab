<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/app_version" style="@style/Body" android:textColor="@color/accent" android:textSize="12sp" android:letterSpacing="0.08" />
        <TextView style="@style/SectionTitle" android:layout_marginTop="8dp" android:text="@string/maps_title" android:textSize="30sp" />
        <TextView style="@style/Body" android:layout_marginTop="8dp" android:text="@string/home_intro" />
        <TextView android:id="@+id/home_access_status" style="@style/Body" android:layout_marginTop="16dp" />
        <Button android:id="@+id/home_access" style="@style/TestButton" android:text="@string/maps_access" />
        <include layout="@layout/tripper_controls" />
        <Button android:id="@+id/home_help" style="@style/TestButton" android:layout_marginTop="16dp" android:text="@string/help_title" />
        <TextView android:id="@+id/capture_notice" style="@style/Body" android:text="@string/capture_notice" android:textColor="@color/accent" android:visibility="gone" />
        <Button android:id="@+id/tools_toggle" style="@style/TestButton" android:text="@string/tools_show" />
        <LinearLayout android:id="@+id/tools_group" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <Button android:id="@+id/home_diagnostics" style="@style/TestButton" android:text="@string/home_diagnostics" />
            <Button android:id="@+id/home_battery" style="@style/TestButton" android:text="@string/battery_measure" />
            <Button android:id="@+id/forget_button" style="@style/TestButton" android:text="@string/forget" />
            <Button android:id="@+id/log_button" style="@style/TestButton" android:text="@string/view_log" />
            <TextView android:id="@+id/packet_counts" style="@style/Body" android:textSize="13sp" />
            <TextView style="@style/SectionTitle" android:layout_marginTop="24dp" android:text="@string/device_title" />
            <TextView android:id="@+id/device_info" style="@style/Body" android:layout_marginTop="8dp" android:textIsSelectable="true" />
            <TextView style="@style/SectionTitle" android:layout_marginTop="24dp" android:text="@string/battery_title" />
            <TextView android:id="@+id/battery_info" style="@style/Body" android:layout_marginTop="8dp" android:textIsSelectable="true" />
            <TextView style="@style/Body" android:layout_marginTop="8dp" android:text="@string/battery_note" android:textSize="13sp" />
            <TextView android:id="@+id/updated_at" style="@style/Body" android:layout_marginTop="8dp" android:textSize="13sp" android:accessibilityLiveRegion="polite" />
            <Button android:id="@+id/refresh_button" style="@style/TestButton" android:text="@string/refresh" />
            <Button android:id="@+id/copy_button" style="@style/TestButton" android:text="@string/copy" />
        </LinearLayout>
        <TextView style="@style/Body" android:layout_marginTop="16dp" android:text="@string/privacy" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
